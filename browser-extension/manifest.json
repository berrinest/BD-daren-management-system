{
  "manifest_version": 3,
  "name": "BD 达人资源采集",
  "description": "将当前公开达人主页资料发送到 BD 达人管理系统资源池。",
  "version": "0.1.1",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://douyin.com/user/*",
        "https://*.douyin.com/user/*"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://bd-daren-management-system.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content/app-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "采集达人资源",
    "default_popup": "popup/index.html"
  }
}
